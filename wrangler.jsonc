{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rishta-biodata",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "rishtabiodata.com",
      "custom_domain": true
    },
    {
      "pattern": "www.rishtabiodata.com",
      "custom_domain": true
    },
    {
      "pattern": "rishtabiodata.in",
      "custom_domain": true
    },
    {
      "pattern": "www.rishtabiodata.in",
      "custom_domain": true
    }
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "ratelimits": [
    {
      "name": "PAYMENT_ORDER_RATE_LIMITER",
      "namespace_id": "31085101",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "PAYMENT_VERIFY_RATE_LIMITER",
      "namespace_id": "31085102",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "31085103",
      "simple": { "limit": 3, "period": 60 }
    }
  ]
}
